# API
ASPNETCORE_URLS=http://0.0.0.0:8080
ASPNETCORE_ENVIRONMENT=Development

# DB
POSTGRES_USER=app
POSTGRES_PASSWORD=app_pw
POSTGRES_DB=myapi
POSTGRES_PORT=5432

# 接続文字列（EF Core 用）
ConnectionStrings__Default=Host=db;Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
